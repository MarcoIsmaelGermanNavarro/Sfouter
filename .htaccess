RewriteEngine On

# 1. Proteger archivos sensibles (que nadie pueda descargar tu código)
RewriteRule ^(src|config|storage|vendor)/ - [F,L]

# 2. Redirección al index.php dentro de public
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]